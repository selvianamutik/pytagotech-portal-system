# Environment Variables — Template

# Salin file ini menjadi .env.local (untuk development) atau .env (untuk production)
# JANGAN commit file .env atau .env.local ke repository

# ─────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────
# Didapat dari: Supabase Dashboard → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key — HANYA dipakai di sisi server (API Routes / Server Actions)
# JANGAN expose ke client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─────────────────────────────────────────────
# Aplikasi
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Pytagotech Portal

# Zona waktu (dipakai untuk perhitungan SLA & jadwal)
TZ=Asia/Jakarta

# ─────────────────────────────────────────────
# Upload / Storage
# ─────────────────────────────────────────────
# Batas ukuran lampiran per file (dalam bytes)
# Default: 10MB = 10485760
NEXT_PUBLIC_MAX_ATTACHMENT_SIZE_BYTES=10485760
